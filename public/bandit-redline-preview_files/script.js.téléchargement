let currentLanguage = localStorage.getItem("banditJournalLanguage") || "en";

document.addEventListener("DOMContentLoaded", () => {
  renderLevels();
  renderToc();
  applyLanguage(currentLanguage);
  initTerminalAnimation();
  initMobileMenu();
  initMobileToc();
  initLanguageButtons();
  initScrollProgress();
  initBackToTop();
  initScrollSpy();
  initCloseMobileMenuOnClick();
});

function applyLanguage(lang) {
  currentLanguage = lang;
  localStorage.setItem("banditJournalLanguage", lang);
  document.documentElement.lang = lang;

  document.querySelectorAll("[data-i18n]").forEach((element) => {
    const key = element.getAttribute("data-i18n");
    if (translations[lang][key]) {
      element.textContent = translations[lang][key];
    }
  });

  document.querySelectorAll(".language-button").forEach((button) => {
    button.classList.toggle("active", button.dataset.lang === lang);
  });

  renderLevels();
  renderToc();
  updateBackToTopText();
}

function renderLevels() {
  const container = document.getElementById("levels-container");
  if (!container) return;

  const t = translations[currentLanguage];
  container.innerHTML = "";

  levels.forEach((level, index) => {
    const content = level.content[currentLanguage];
    const isOpen = index === 0;
    const statusText =
      level.status === "completed" ? t.status_completed : t.status_learning;
    const statusClass =
      level.status === "completed" ? "status-completed" : "status-learning";

    const card = document.createElement("article");
    card.className = `level-card ${isOpen ? "open" : ""}`;
    card.id = level.id;

    card.innerHTML = `
      <button class="level-header" type="button" aria-expanded="${isOpen}">
        <span class="level-title-group">
          <span class="level-title">${level.title[currentLanguage]}</span>
          <span class="status-badge ${statusClass}">${statusText}</span>
        </span>
        <span class="accordion-icon" aria-hidden="true">⌄</span>
      </button>

      <div class="level-panel">
        <div class="level-inner">
          ${renderContentBlock(t.label_goal, content.goal)}
          ${renderContentBlock(t.label_know, content.know)}
          ${renderCodeBlock(t.label_commands, content.commands)}
          ${renderContentBlock(t.label_explanation, content.explanation)}
          ${renderContentBlock(t.label_mistake, content.mistake)}
          ${renderContentBlock(t.label_takeaway, content.takeaway)}
        </div>
      </div>
    `;

    container.appendChild(card);

    const panel = card.querySelector(".level-panel");
    if (isOpen) {
      panel.style.maxHeight = `${panel.scrollHeight}px`;
    }

    const header = card.querySelector(".level-header");
    header.addEventListener("click", () => toggleAccordion(card));
  });
}

function renderContentBlock(label, text) {
  return `
    <section class="content-block">
      <h3 class="content-label">${label}</h3>
      <p class="level-text">${formatInlineCode(text)}</p>
    </section>
  `;
}

function renderCodeBlock(label, commands) {
  return `
    <section class="content-block">
      <h3 class="content-label">${label}</h3>
      <div class="code-wrapper">
        <pre class="code-block"><code>${escapeHtml(commands)}</code></pre>
        <button class="copy-button" type="button">${translations[currentLanguage].copy}</button>
      </div>
    </section>
  `;
}

function renderToc() {
  const desktopToc = document.getElementById("desktop-toc");
  const mobileToc = document.getElementById("mobile-toc");

  if (!desktopToc || !mobileToc) return;

  desktopToc.innerHTML = "";
  mobileToc.innerHTML = "";

  levels.forEach((level) => {
    const title = level.title[currentLanguage];
    const itemHtml = `
      <li>
        <a class="toc-link" href="#${level.id}">${title}</a>
      </li>
    `;

    desktopToc.insertAdjacentHTML("beforeend", itemHtml);
    mobileToc.insertAdjacentHTML("beforeend", itemHtml);
  });

  document.querySelectorAll(".toc-link").forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileToc();
    });
  });
}

function toggleAccordion(card) {
  const panel = card.querySelector(".level-panel");
  const header = card.querySelector(".level-header");
  const isOpen = card.classList.contains("open");

  if (isOpen) {
    card.classList.remove("open");
    header.setAttribute("aria-expanded", "false");
    panel.style.maxHeight = "0px";
  } else {
    card.classList.add("open");
    header.setAttribute("aria-expanded", "true");
    panel.style.maxHeight = `${panel.scrollHeight}px`;
  }
}

document.addEventListener("click", async (event) => {
  const button = event.target.closest(".copy-button");
  if (!button) return;

  const code = button.parentElement.querySelector("code");
  if (!code) return;

  const textToCopy = code.innerText;
  const t = translations[currentLanguage];

  try {
    await navigator.clipboard.writeText(textToCopy);
    button.textContent = t.copied;

    setTimeout(() => {
      button.textContent = translations[currentLanguage].copy;
    }, 2000);
  } catch {
    button.textContent = "Error";

    setTimeout(() => {
      button.textContent = translations[currentLanguage].copy;
    }, 2000);
  }
});

function initLanguageButtons() {
  document.querySelectorAll(".language-button").forEach((button) => {
    button.addEventListener("click", () => {
      applyLanguage(button.dataset.lang);
    });
  });
}

function initMobileMenu() {
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("nav-menu");

  if (!button || !menu) return;

  button.addEventListener("click", () => {
    const isOpen = menu.classList.toggle("open");
    button.setAttribute("aria-expanded", String(isOpen));
  });
}

function initCloseMobileMenuOnClick() {
  const menu = document.getElementById("nav-menu");
  const button = document.getElementById("mobile-menu-button");

  if (!menu || !button) return;

  menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.remove("open");
      button.setAttribute("aria-expanded", "false");
    });
  });
}

function initMobileToc() {
  const button = document.getElementById("mobile-toc-button");
  const panel = document.getElementById("mobile-toc-panel");

  if (!button || !panel) return;

  button.addEventListener("click", () => {
    const isOpen = panel.classList.toggle("open");
    button.setAttribute("aria-expanded", String(isOpen));
  });
}

function closeMobileToc() {
  const button = document.getElementById("mobile-toc-button");
  const panel = document.getElementById("mobile-toc-panel");

  if (!button || !panel) return;

  panel.classList.remove("open");
  button.setAttribute("aria-expanded", "false");
}

function initTerminalAnimation() {
  const terminalBody = document.getElementById("terminal-body");
  if (!terminalBody) return;

  const lines = [
    {
      command: "ssh bandit0@bandit.labs.overthewire.org -p 2220",
      output: "Welcome to OverTheWire Bandit."
    },
    {
      command: "ls",
      output: "readme"
    },
    {
      command: "cat readme",
      output: "[PASSWORD_REDACTED]"
    },
    {
      command: "find . -type f -size 1033c ! -executable",
      output: "./inhere/maybehere07/.file2"
    },
    {
      command: "grep millionth data.txt",
      output: "millionth    [PASSWORD_REDACTED]"
    },
    {
      command: "base64 -d data.txt",
      output: "Decoded content hidden for learning."
    },
    {
      command:
        "ssh -i sshkey.private bandit14@bandit.labs.overthewire.org -p 2220",
      output: "Authentication method: private key"
    }
  ];

  terminalBody.innerHTML = "";

  lines.forEach((line, index) => {
    setTimeout(() => {
      const commandLine = document.createElement("div");
      commandLine.className = "terminal-line";
      commandLine.innerHTML = `
        <span class="terminal-prompt">emma@bandit:~$</span>
        <span class="terminal-command">${escapeHtml(line.command)}</span>
      `;
      terminalBody.appendChild(commandLine);

      setTimeout(() => {
        const outputLine = document.createElement("div");
        outputLine.className = "terminal-output";
        outputLine.textContent = line.output;
        terminalBody.appendChild(outputLine);
      }, 350);
    }, index * 950);
  });

  setTimeout(() => {
    const cursorLine = document.createElement("div");
    cursorLine.className = "terminal-line";
    cursorLine.style.opacity = "1";
    cursorLine.style.transform = "translateY(0)";
    cursorLine.innerHTML = `
      <span class="terminal-prompt">emma@bandit:~$</span>
      <span class="cursor"></span>
    `;
    terminalBody.appendChild(cursorLine);
  }, lines.length * 950 + 500);
}

function initScrollProgress() {
  const progress = document.getElementById("scroll-progress");
  if (!progress) return;

  window.addEventListener("scroll", () => {
    const scrollTop = window.scrollY;
    const pageHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progressWidth = pageHeight > 0 ? (scrollTop / pageHeight) * 100 : 0;

    progress.style.width = `${progressWidth}%`;
  });
}

function initBackToTop() {
  const button = document.getElementById("back-to-top");
  if (!button) return;

  window.addEventListener("scroll", () => {
    if (window.scrollY > 500) {
      button.classList.add("visible");
    } else {
      button.classList.remove("visible");
    }
  });

  button.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
}

function updateBackToTopText() {
  const button = document.getElementById("back-to-top");
  if (!button) return;

  button.textContent = translations[currentLanguage].btn_top;
}

function initScrollSpy() {
  window.addEventListener("scroll", updateActiveTocLink);
  window.addEventListener("resize", updateActiveTocLink);
  updateActiveTocLink();
}

function updateActiveTocLink() {
  const cards = document.querySelectorAll(".level-card");
  const tocLinks = document.querySelectorAll(".toc-link");

  if (!cards.length || !tocLinks.length) return;

  let currentId = cards[0].id;

  cards.forEach((card) => {
    const rect = card.getBoundingClientRect();
    if (rect.top <= 150) {
      currentId = card.id;
    }
  });

  tocLinks.forEach((link) => {
    const href = link.getAttribute("href");
    link.classList.toggle("active", href === `#${currentId}`);
  });
}

function formatInlineCode(text) {
  return escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>");
}

function escapeHtml(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}
